<Window x:Class="DownloadsFlyout.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloads" Width="472" Height="572"
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable, Segoe UI"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="FgBrush" Color="White"/>
    <SolidColorBrush x:Key="LineBrush" Color="#444444"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="SelBrush" Color="#550078D4"/>

    <Style x:Key="ItemStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="B" CornerRadius="8" Background="Transparent" Padding="4">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource SelBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_RightDown"/>
    </Style>

    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="6" Padding="10,5" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
  <Border x:Name="Panel" CornerRadius="12" BorderThickness="1"
          BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource BgBrush}">
    <Border.RenderTransform><TranslateTransform x:Name="Slide"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Margin="16,12,10,6">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
        <Button Content="Open in Explorer" Style="{StaticResource FlatButton}"
                HorizontalAlignment="Right" Click="OpenFolder_Click"/>
      </Grid>

      <ListBox x:Name="FileList" Grid.Row="1" Margin="8,0,4,8"
               Background="Transparent" BorderThickness="0"
               SelectionMode="Extended"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ItemContainerStyle="{StaticResource ItemStyle}"
               PreviewMouseLeftButtonDown="List_MouseDown"
               PreviewMouseMove="List_MouseMove">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="88" ToolTip="{Binding Name}">
              <Image Source="{Binding Icon}" Width="56" Height="56" Margin="0,4"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                         TextAlignment="Center" FontSize="12" MaxHeight="34"
                         Foreground="{DynamicResource FgBrush}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open" Click="Menu_Open"/>
            <MenuItem Header="Show in folder" Click="Menu_Show"/>
            <Separator/>
            <MenuItem Header="Copy" Click="Menu_Copy"/>
            <MenuItem Header="Cut" Click="Menu_Cut"/>
            <MenuItem Header="Copy path" Click="Menu_CopyPath"/>
            <Separator/>
            <MenuItem Header="Delete" Click="Menu_Delete"/>
          </ContextMenu>
        </ListBox.ContextMenu>
      </ListBox>
    </Grid>
  </Border>
  </Grid>
</Window>
